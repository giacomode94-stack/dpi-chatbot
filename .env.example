# ─── VARIABILI AMBIENTE PER RENDER.COM ───────────────────────────────────────
# Copia questi valori nelle Environment Variables di Render

# Token temporaneo generato su Meta Developer Portal
WHATSAPP_TOKEN=il_tuo_token_qui

# ID del numero di telefono (trovato su Configurazione API)
PHONE_NUMBER_ID=122425334097820

# Token segreto per verificare il webhook (puoi sceglierlo tu)
VERIFY_TOKEN=dpi_chatbot_token

# Porta (Render la gestisce automaticamente)
PORT=3000

# ─── EMAIL (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=il_tuo_sendgrid_api_key
EMAIL_MITTENTE=info@depasqualeimpianti.com
EMAIL_DESTINATARIO=info@depasqualeimpianti.com

# ─── INVIO AUTOMATICO CONFERMA APPUNTAMENTO ────────────────────────────────────
# Token segreto a piacere: va aggiunto come ?secret=... nell'URL configurato
# su SendGrid Inbound Parse, per evitare che chiunque scopra l'URL possa
# far inviare messaggi WhatsApp a piacimento.
INBOUND_SECRET=scegli_un_token_a_caso

# Nome del template WhatsApp usato per la conferma (default: conferma_appuntamento_v2)
TEMPLATE_CONFERMA_APPUNTAMENTO=conferma_appuntamento_v2
